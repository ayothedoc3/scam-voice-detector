# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/scamshield
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/scamshield

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Keys
RESEMBLE_API_KEY=your_resemble_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Redis (for WebSocket/background tasks)
REDIS_URL=redis://localhost:6379/0

# Server Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE=52428800

# Logging
LOG_LEVEL=INFO
